# ===== NextAuth =====
NEXTAUTH_URL=https://your-vercel-url.vercel.app
NEXTAUTH_SECRET=your-random-secret-min-32-chars

# ===== Built-in admin password =====
# Default: Admin1234! (change this in production)
ADMIN_PASSWORD=ChangeMeInProduction!

# ===== Google OAuth (optional — for "Sign in with Google" button) =====
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===== Supabase (optional — for persistent users / settings) =====
# Without these, the app falls back to in-memory storage that resets
# on Vercel cold starts. See supabase/SETUP.md for setup steps.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJ...

# ===== Outbound email — self-service "forgot password" (optional) =====
# Postmark Server API Token: Postmark → Servers → <server> → API Tokens.
# The From address must sit on a DKIM-verified domain in Postmark
# (Sender Signatures → Add a DKIM DNS record).
# Without these, forgot-password requests still get logged in the
# workspace's "ทีมงานและสิทธิ์" queue for an admin to reset manually,
# but no email is sent.
POSTMARK_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MAIL_FROM_ADDRESS=apps@initialestate.com
MAIL_FROM_NAME=INITIAL Supply Chain

# ===== AI assist (optional) =====
ANTHROPIC_API_KEY=sk-ant-...

# ===== Google Drive attachments (optional) =====
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_DRIVE_PARENT_FOLDER_ID=your-drive-folder-id

# ===== Break-glass admin password reset (optional, emergency use only) =====
MAINTENANCE_TOKEN=a-long-random-secret
